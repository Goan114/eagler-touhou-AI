{
  "manifest_version":3,
  "name":"Eagler Touhou · 我的 AI 接管",
  "version":"0.1.1",
  "description":"在自己的浏览器中用 AI 接管红魔乡联机座位。",
  "permissions":["scripting","activeTab"],
  "host_permissions":["https://touhouonline.com/*","https://*.touhouonline.com/*","https://touhou.vip/*","https://*.touhou.vip/*","http://127.0.0.1/*","http://localhost/*"],
  "background":{"service_worker":"background.js","type":"module"},
  "action":{"default_popup":"popup.html","default_title":"AI 接管我的机体"},
  "content_scripts":[{
    "matches":["https://touhouonline.com/*","https://*.touhouonline.com/*","https://touhou.vip/*","https://*.touhou.vip/*","http://127.0.0.1/*","http://localhost/*"],
    "js":["capture-document.js"],"run_at":"document_start","all_frames":true
  }]
}
